# Rockchip BSP media stack for RK3399 (mpp_service + rkvdec/vdpu2/vepu2 + rga2)
#
# Usage:
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- defconfig
#   scripts/kconfig/merge_config.sh -m .config arch/arm64/configs/rk3399-mpp.config
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- olddefconfig
#
# Boards must include arch/arm64/boot/dts/rockchip/rk3399-mpp.dtsi (as
# rk3399-firefly.dts, rk3399-am40.dts and rk3399-vpu.dtsi do) for the
# devices to appear. Note: these options are already part of the arm64
# defconfig in this tree; this fragment is for other base configs.

# SoC glue the MPP drivers depend on
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ROCKCHIP_GRF=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_DMA=y

# MPP service framework: /dev/mpp_service
CONFIG_ROCKCHIP_MPP_SERVICE=y
CONFIG_ROCKCHIP_MPP_PROC_FS=y

# MPP sub devices used on RK3399
CONFIG_ROCKCHIP_MPP_RKVDEC=y
CONFIG_ROCKCHIP_MPP_VDPU2=y
CONFIG_ROCKCHIP_MPP_VEPU2=y

# Rockchip BSP RGA2 (2D engine, librga ioctl ABI, /dev/rga)
CONFIG_ROCKCHIP_RGA2=y
CONFIG_ROCKCHIP_RGA2_DEBUG_FS=y
# /proc/rga - handy for on-board bring-up checks (matches BSP default)
CONFIG_ROCKCHIP_RGA2_PROC_FS=y

# Buffer allocation for librockchip_mpp / librga (dma-heap)
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_SYSFS_STATS=y
CONFIG_UDMABUF=y

# Upstream drivers that fight over the same register windows.
# They may stay enabled as modules; the board dtsi keeps their nodes
# disabled so the MPP drivers own the hardware.
#
# VIDEO_ROCKCHIP_RGA only matches "rockchip,rk3288-rga"/"rockchip,rk3399-rga",
# while the board dtsi gives the RGA node "rockchip,rga2" (BSP driver).
# The two can therefore coexist safely; do NOT also enable ROCKCHIP_RGA.
CONFIG_VIDEO_ROCKCHIP_RGA=m
# CONFIG_VIDEO_ROCKCHIP_VPU is not set
# CONFIG_VIDEO_ROCKCHIP_VDEC is not set
# CONFIG_ROCKCHIP_RGA is not set
